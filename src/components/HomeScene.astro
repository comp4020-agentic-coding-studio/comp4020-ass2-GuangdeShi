---
import MiloFigure from "./MiloFigure.astro";
---

<svg
  class="home-room"
  viewBox="0 0 1200 720"
  role="img"
  aria-labelledby="room-title room-description"
  preserveAspectRatio="xMidYMid slice"
>
  <title id="room-title">Milo's home across her life</title>
  <desc id="room-description">
    A warm living room with a sofa, window, door, carrier, feeding area, observation notebook,
    and changing care adaptations for Milo at five stages of life.
  </desc>

  <defs>
    <linearGradient id="wall-light" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#f6f0e4" />
      <stop offset="1" stop-color="#e9ddc9" />
    </linearGradient>
    <linearGradient id="floor-light" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#caa97c" />
      <stop offset="1" stop-color="#a98058" />
    </linearGradient>
    <linearGradient id="sofa-fabric" x1="0" x2="0.9" y1="0" y2="1">
      <stop offset="0" stop-color="#718b82" />
      <stop offset="1" stop-color="#3e5c57" />
    </linearGradient>
    <linearGradient id="window-sky" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#a9ced0" />
      <stop offset="0.66" stop-color="#d8e1c6" />
      <stop offset="1" stop-color="#78956c" />
    </linearGradient>
    <filter id="room-shadow" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="10" stdDeviation="9" flood-color="#263b39" flood-opacity="0.2" />
    </filter>
    <filter id="soft-shadow" x="-40%" y="-40%" width="180%" height="200%">
      <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#263b39" flood-opacity="0.22" />
    </filter>
  </defs>

  <rect width="1200" height="518" fill="url(#wall-light)" />
  <path d="M0 518h1200v202H0z" fill="url(#floor-light)" />
  <path d="M0 512h1200v14H0z" fill="#f9f2e5" />
  <path d="M0 527h1200" stroke="#725b46" stroke-width="4" opacity="0.45" />
  <g stroke="#765d44" stroke-width="2" opacity="0.24">
    <path d="M60 526 4 720M220 526l-10 194M388 526l35 194M556 526l78 194M724 526l122 194M892 526l166 194M1062 526l138 131" />
    <path d="M0 590h1200M0 661h1200" />
  </g>

  <g filter="url(#room-shadow)">
    <rect x="760" y="58" width="282" height="300" rx="8" fill="#fcf8ef" stroke="#405955" stroke-width="13" />
    <rect x="780" y="79" width="242" height="255" fill="url(#window-sky)" />
    <path d="M780 275c69-47 121-27 166-70 26-25 52-31 76-35v164H780z" fill="#6f956b" opacity="0.68" />
    <path d="M902 81v252M782 201h238" stroke="#f7f0e2" stroke-width="10" />
    <path d="M747 359h310" stroke="#405955" stroke-linecap="round" stroke-width="18" />
    <path d="M752 72c-32 67-24 194-4 270M1050 72c30 64 27 194 5 270" fill="none" stroke="#bd7a61" stroke-width="24" opacity="0.9" />
  </g>

  <g filter="url(#soft-shadow)">
    <rect x="1070" y="155" width="104" height="360" rx="5" fill="#b9654e" stroke="#405955" stroke-width="8" />
    <path d="M1092 178h61v315h-61z" fill="#c9785e" opacity="0.76" />
    <circle cx="1092" cy="336" r="9" fill="#e9c874" stroke="#405955" stroke-width="4" />
  </g>

  <g filter="url(#room-shadow)">
    <path d="M205 365q0-38 38-38h353q38 0 38 38v185H205z" fill="url(#sofa-fabric)" stroke="#334a47" stroke-width="9" />
    <rect x="224" y="373" width="188" height="124" rx="25" fill="#66817a" stroke="#46645f" stroke-width="6" />
    <rect x="425" y="373" width="188" height="124" rx="25" fill="#617c75" stroke="#46645f" stroke-width="6" />
    <path d="M172 383q0-31 31-31h32v198h-63zM604 352h31q31 0 31 31v167h-62z" fill="#46645f" stroke="#334a47" stroke-width="9" />
    <path d="M232 542v35M603 542v35" stroke="#334a47" stroke-linecap="round" stroke-width="15" />
    <path d="M267 401c26-17 61-19 95-5M470 400c27-16 59-17 94-4" fill="none" stroke="#91a69f" stroke-linecap="round" stroke-width="5" opacity="0.58" />
    <path d="M186 428c16 11 31 11 45 2" fill="none" stroke="#d6a57e" stroke-linecap="round" stroke-width="5" />
  </g>

  <g filter="url(#soft-shadow)">
    <ellipse cx="570" cy="625" rx="330" ry="75" fill="#d7c7a4" />
    <ellipse cx="570" cy="625" rx="287" ry="55" fill="none" stroke="#b65f4b" stroke-width="5" stroke-dasharray="12 13" opacity="0.75" />
  </g>

  <g filter="url(#soft-shadow)">
    <path d="M745 456h166l33 106H711z" fill="#d7a84c" stroke="#405955" stroke-width="8" />
    <path d="M758 456c6-62 43-88 77-88s72 26 79 88" fill="none" stroke="#405955" stroke-width="9" />
    <path d="M772 477h107v85H772z" fill="#314744" />
    <path d="M788 481v77m19-77v77m19-77v77m19-77v77m19-77v77" stroke="#efe3ca" stroke-width="6" />
    <path d="M735 559h202" stroke="#405955" stroke-linecap="round" stroke-width="10" />
  </g>

  <g filter="url(#soft-shadow)">
    <ellipse cx="1015" cy="603" rx="122" ry="37" fill="#b55f4a" />
    <path d="M923 594h70l-7 42h-56z" fill="#ede7db" stroke="#405955" stroke-width="6" />
    <ellipse cx="958" cy="594" rx="35" ry="10" fill="#c9b06e" />
    <path d="M1008 594h70l-7 42h-56z" fill="#8bb5b7" stroke="#405955" stroke-width="6" />
    <ellipse cx="1043" cy="594" rx="35" ry="10" fill="#d8eef0" />
  </g>

  <g filter="url(#soft-shadow)">
    <path d="M50 594h137l-15 68H64z" fill="#c8a35b" stroke="#405955" stroke-width="7" />
    <path d="M74 594c29-17 60-17 91 0" fill="#e9dcc0" />
    <path d="M82 618h81" stroke="#e4cf9e" stroke-width="4" opacity="0.8" />
  </g>

  <g transform="rotate(-6 682 407)" filter="url(#soft-shadow)">
    <rect x="627" y="368" width="112" height="78" rx="5" fill="#fffaf0" stroke="#405955" stroke-width="6" />
    <path d="M650 389h65m-65 15h57m-57 15h62" stroke="#bd654e" stroke-linecap="round" stroke-width="4" />
    <path d="M640 369v76" stroke="#c3ac7d" stroke-width="6" />
  </g>

  <g data-room-stage="kitten">
    <g filter="url(#soft-shadow)">
      <MiloFigure stage="kitten" pose="cautious" x={712} y={612} scale={0.58} idPrefix="home-kitten" />
    </g>
    <g transform="translate(89 370)" filter="url(#soft-shadow)">
      <path d="M0 77h137v94H0z" fill="#d9bd82" stroke="#405955" stroke-width="7" />
      <path d="M0 77 68 31l69 46" fill="#d99a63" stroke="#405955" stroke-width="7" />
      <path d="M43 171v-48c0-28 14-43 30-43s31 15 31 43v48" fill="#334a47" />
    </g>
  </g>

  <g data-room-stage="young-adult" style="display:none">
    <g filter="url(#soft-shadow)">
      <MiloFigure stage="young-adult" pose="standing" x={710} y={622} scale={0.62} idPrefix="home-young-adult" />
    </g>
    <g filter="url(#soft-shadow)">
      <path d="M119 515h112" stroke="#405955" stroke-linecap="round" stroke-width="18" />
      <path d="M175 512V273" stroke="#9e7544" stroke-width="35" />
      <path d="M175 498V289" stroke="#d6ad68" stroke-dasharray="7 9" stroke-width="25" />
      <path d="M120 273h110" stroke="#405955" stroke-linecap="round" stroke-width="16" />
    </g>
    <path d="M249 472c24-14 43-7 54 18-20 13-40 7-54-18z" fill="#c7624a" />
    <path d="M254 469l-17-19" stroke="#405955" stroke-width="4" />
  </g>

  <g data-room-stage="mature" style="display:none">
    <g filter="url(#soft-shadow)">
      <MiloFigure stage="mature" pose="resting" x={404} y={463} scale={0.62} idPrefix="home-mature" />
    </g>
    <path d="M849 416c28-18 59-18 88 0" fill="none" stroke="#bd654e" stroke-linecap="round" stroke-width="7" />
  </g>

  <g data-room-stage="senior" style="display:none">
    <path d="M233 548h390l94 109H341z" fill="#d8c39d" stroke="#405955" stroke-linejoin="round" stroke-width="8" filter="url(#soft-shadow)" />
    <path d="M330 579h320M363 614h319" stroke="#a5784e" stroke-width="6" />
    <g filter="url(#soft-shadow)">
      <MiloFigure stage="senior" pose="slow" x={760} y={623} scale={0.66} idPrefix="home-senior" />
    </g>
    <g transform="translate(123 280)" filter="url(#soft-shadow)">
      <path d="M0 62h86" stroke="#405955" stroke-linecap="round" stroke-width="9" />
      <path d="M43 62v98" stroke="#405955" stroke-width="8" />
      <circle cx="43" cy="26" r="32" fill="#efd17a" stroke="#405955" stroke-width="7" />
      <circle cx="43" cy="26" r="15" fill="#fff3b5" opacity="0.72" />
    </g>
  </g>

  <g data-room-stage="very-old" style="display:none">
    <path d="M602 514h212l-99 117H478z" fill="#dbc7a2" stroke="#405955" stroke-linejoin="round" stroke-width="8" filter="url(#soft-shadow)" />
    <path d="M515 589h229" stroke="#a5784e" stroke-width="6" />
    <g filter="url(#soft-shadow)">
      <MiloFigure stage="very-old" pose="curled" x={683} y={607} scale={0.72} idPrefix="home-very-old" />
    </g>
    <g transform="translate(956 462)" filter="url(#soft-shadow)">
      <rect width="130" height="82" rx="6" fill="#fffaf0" stroke="#405955" stroke-width="7" />
      <path d="M22 24h86M22 43h69M22 62h79" stroke="#bd654e" stroke-linecap="round" stroke-width="5" />
      <path d="M12 0v82" stroke="#c2a978" stroke-width="7" />
    </g>
  </g>
</svg>
