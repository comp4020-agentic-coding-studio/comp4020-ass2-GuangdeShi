---
import EditorialRoomScene from "./EditorialRoomScene.astro";

interface Props {
  phase?: "arrival" | "return";
}

const { phase = "arrival" } = Astro.props;
---

<EditorialRoomScene
  moment="arrival"
  variant="scenario"
  phase={phase}
  title="Milo's safe room during her first day"
  description="A quiet room with separated food, water, and litter resources, an open carrier, a hiding box, and kitten Milo watching from beneath the bed."
  caption={phase === "arrival"
    ? "Arrival, minute six: the carrier is open and Milo is under the bed."
    : "Later that evening: the room has stayed quiet, and Milo has begun watching from the edge of cover."}
/>
