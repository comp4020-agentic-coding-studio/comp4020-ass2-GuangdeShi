---
import type { LifecycleStageId } from "../data/chapters";

interface Props {
  stage: LifecycleStageId;
  pose?: "cautious" | "standing" | "scratching" | "resting" | "slow" | "curled";
  x?: number;
  y?: number;
  scale?: number;
  flip?: boolean;
  idPrefix: string;
}

const {
  stage,
  pose = stage === "kitten"
    ? "cautious"
    : stage === "young-adult"
      ? "standing"
      : stage === "mature"
        ? "resting"
        : stage === "senior"
          ? "slow"
          : "curled",
  x = 0,
  y = 0,
  scale = 1,
  flip = false,
  idPrefix,
} = Astro.props;

const furId = `${idPrefix}-fur`;
const paleFurId = `${idPrefix}-pale-fur`;
const transform = `translate(${x} ${y}) scale(${flip ? -scale : scale} ${scale})`;
---

<g class:list={["milo-figure", `milo-figure--${stage}`, `milo-figure--${pose}`]} data-milo-stage={stage} transform={transform} aria-hidden="true">
  <defs>
    <linearGradient id={furId} x1="0" x2="0.9" y1="0" y2="1">
      <stop offset="0" stop-color={stage === "very-old" ? "#a69c91" : "#a49a8c"} />
      <stop offset="0.5" stop-color={stage === "very-old" ? "#817a73" : "#756f68"} />
      <stop offset="1" stop-color="#4d504d" />
    </linearGradient>
    <linearGradient id={paleFurId} x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#d8cdc0" />
      <stop offset="1" stop-color="#a99d92" />
    </linearGradient>
  </defs>

  {stage === "kitten" && (
    <g>
      <path d="M-12-68C26-89 81-75 96-39 106-14 88 7 52 9 14 11-20-5-27-31c-4-15 1-28 15-37Z" fill={`url(#${furId})`} />
