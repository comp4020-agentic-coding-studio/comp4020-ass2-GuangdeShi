---
interface Option {
  id: string;
  text: string;
  feedback?: string;
}

interface Props {
  id: string;
  phase: "initial" | "revised" | "transfer";
  prompt: string;
  options: Option[];
  bestOption: string;
  storageKey?: string;
}

const { id, phase, prompt, options, bestOption, storageKey: suppliedStorageKey } = Astro.props;
const isRevised = phase === "revised";
const storageKey = suppliedStorageKey ?? (id === "arrival-initial"
  ? "momo-ch01-initial-judgement"
  : id === "arrival-revised"
    ? "momo-ch01-revised-judgement"
    : `milo-ch01-${id}-judgement`);
---

<form
  class:list={["judgement-question", `judgement-question--${phase}`]}
  data-judgement
  data-storage-key={storageKey}
  data-best-option={bestOption}
>
  <fieldset>
    <legend>{prompt}</legend>
    <div class="judgement-options">
      {options.map((option) => (
        <label>
          <input type="radio" name={id} value={option.id} required />
          <span>
            <span><strong>{option.id.toUpperCase()}</strong>{option.text}</span>
            {option.feedback && <small class="judgement-option__feedback" data-judgement-feedback hidden>{option.feedback}</small>}
          </span>
        </label>
      ))}
    </div>
  </fieldset>
  {isRevised && (
    <label class="judgement-rationale">
      <span>What changed or strengthened your reasoning?</span>
      <textarea name={`${id}-rationale`} rows="4"></textarea>
    </label>
  )}
  <div class="judgement-actions">
    <button type="submit">Save {isRevised ? "revised" : phase} judgement</button>
    <p data-judgement-status aria-live="polite"></p>
  </div>
</form>

<script>
  function setupJudgements() {
    for (const form of document.querySelectorAll<HTMLFormElement>("[data-judgement]")) {
      if (form.dataset.initialized === "true") continue;
      form.dataset.initialized = "true";
      const key = form.dataset.storageKey ?? "";
      const status = form.querySelector<HTMLElement>("[data-judgement-status]")!;
      const rationale = form.querySelector<HTMLTextAreaElement>("textarea");
      const saved = localStorage.getItem(key);

      if (saved) {
        const state = JSON.parse(saved) as { option?: string; rationale?: string };
        const radio = form.querySelector<HTMLInputElement>(`input[value="${state.option}"]`);
        if (radio) radio.checked = true;
        if (rationale) rationale.value = state.rationale ?? "";
        if (form.classList.contains("judgement-question--transfer")) {
          form.querySelectorAll<HTMLElement>("[data-judgement-feedback]").forEach((item) => { item.hidden = false; });
        }
        status.textContent = "Your earlier judgement is restored on this device.";
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const radio = form.querySelector<HTMLInputElement>("input[type=radio]:checked");
        if (!radio) return;
        localStorage.setItem(
          key,
          JSON.stringify({ option: radio.value, rationale: rationale?.value ?? "" }),
        );
        if (form.classList.contains("judgement-question--transfer")) {
          form.querySelectorAll<HTMLElement>("[data-judgement-feedback]").forEach((item) => { item.hidden = false; });
        }
        const best = form.dataset.bestOption;
        status.textContent = form.classList.contains("judgement-question--revised")
          ? radio.value === best
            ? "Saved. This judgement now matches the safer care plan."
            : "Saved. Keep this choice in view as you compare it with the care plan below."
          : form.classList.contains("judgement-question--transfer")
            ? "Saved. Compare the timing and the amount of choice in all three responses."
          : "Saved. You will return to this decision after the core learning.";
      });
    }
  }

  setupJudgements();
  document.addEventListener("astro:page-load", setupJudgements);
</script>
