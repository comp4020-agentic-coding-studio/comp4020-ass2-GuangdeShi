---
interface Props {
  title?: string;
  description?: string;
  caption?: string;
}

const {
  title = "Milo in a familiar room",
  description = "An editorial illustration of Milo beside a window, with a field notebook in the foreground.",
  caption = "The same home, read at a different moment in Milo's life.",
} = Astro.props;
---

<figure class="capture-scene-placeholder">
  <svg
    viewBox="0 0 1200 620"
    role="img"
    aria-labelledby="capture-scene-title capture-scene-description"
    preserveAspectRatio="xMidYMid slice"
  >
    <title id="capture-scene-title">{title}</title>
    <desc id="capture-scene-description">{description}</desc>
    <defs>
      <linearGradient id="capture-wall" x1="0" x2="1" y1="0" y2="1">
        <stop offset="0" stop-color="#f2eadc" />
        <stop offset="1" stop-color="#d9c8a9" />
      </linearGradient>
      <linearGradient id="capture-window" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#a9c9ca" />
        <stop offset="1" stop-color="#7b9d83" />
      </linearGradient>
      <filter id="capture-shadow" x="-30%" y="-30%" width="160%" height="180%">
        <feDropShadow dx="0" dy="10" stdDeviation="9" flood-color="#263b39" flood-opacity="0.2" />
      </filter>
    </defs>
    <rect width="1200" height="620" fill="url(#capture-wall)" />
    <rect y="448" width="1200" height="172" fill="#a98560" />
    <path d="M0 448h1200" stroke="#fff9ec" stroke-width="13" />
    <g opacity="0.25" stroke="#59493b" stroke-width="2">
      <path d="M102 462 58 620M305 462l-5 158M508 462l32 158M711 462l69 158M914 462l105 158M1115 462l85 90" />
      <path d="M0 528h1200" />
    </g>
    <g filter="url(#capture-shadow)">
      <rect x="694" y="64" width="350" height="310" rx="7" fill="#fffaf0" stroke="#354b48" stroke-width="14" />
      <rect x="716" y="86" width="306" height="266" fill="url(#capture-window)" />
      <path d="M716 293c79-51 141-17 190-73 35-40 75-48 116-50v182H716z" fill="#6e936b" opacity="0.65" />
      <path d="M869 88v262M718 220h302" stroke="#f7f0e2" stroke-width="11" />
      <path d="M676 72c-29 80-25 205-1 291M1060 72c30 80 28 204 1 291" fill="none" stroke="#bd7158" stroke-width="28" />
    </g>
    <g transform="translate(654 390)" filter="url(#capture-shadow)">
      <ellipse cx="0" cy="87" rx="102" ry="65" fill="#756e65" />
      <circle cx="-82" cy="47" r="48" fill="#7f776d" />
      <path d="M-120 17-111-35-74 6M-65 7-24-38-23 25" fill="#6d6760" stroke="#4c4a47" stroke-linejoin="round" stroke-width="7" />
      <ellipse cx="-99" cy="48" rx="6" ry="9" fill="#bdc879" />
      <ellipse cx="-68" cy="48" rx="6" ry="9" fill="#bdc879" />
      <ellipse cx="-83" cy="70" rx="23" ry="16" fill="#a89b8d" />
      <path d="M-87 65h8m-4 2v8" stroke="#4c4544" stroke-linecap="round" stroke-width="4" />
      <path d="M94 86c100 12 137-47 93-99" fill="none" stroke="#5d5954" stroke-linecap="round" stroke-width="26" />
      <path d="M-43 74c30 13 58 13 88 0M-27 101c27 10 55 9 81-2" fill="none" stroke="#474744" stroke-linecap="round" stroke-width="8" opacity="0.65" />
      <path d="M-98 73-143 67M-97 80-142 87M-69 74-25 65M-68 81-24 91" stroke="#eee5d7" stroke-linecap="round" stroke-width="3" />
    </g>
    <g transform="translate(138 340) rotate(-4)" filter="url(#capture-shadow)">
      <path d="M0 0h380v221H0z" fill="#fffaf0" stroke="#354b48" stroke-width="9" />
      <path d="M190 5v211" stroke="#cbbd9f" stroke-width="7" />
      <path d="M31 47h124M31 83h140M31 119h112M223 47h118M223 83h134M223 119h104" stroke="#bd654e" stroke-linecap="round" stroke-width="8" opacity="0.8" />
      <path d="M31 167h113M223 167h121" stroke="#617873" stroke-linecap="round" stroke-width="6" opacity="0.55" />
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
