---
import { withBase } from "astro-theme-university/url";
import { chapterPath, chapters, lifecycleStages } from "../data/chapters";

const firstStage = lifecycleStages[0];
const consultationHref = (slug: string) => {
  const chapter = chapters.find((item) => item.slug === slug);
  return chapter ? withBase(chapterPath(chapter)) : "";
};
---

<section
  class="interactive-home"
  data-interactive-home
  data-stage={firstStage.id}
  data-stages={JSON.stringify(lifecycleStages)}
  aria-labelledby="home-heading"
>
  <div class="home-intro">
    <div>
      <p class="eyebrow">SLOP8988 · A life in twelve consultations</p>
      <h1 id="home-heading">Momo's Life</h1>
    </div>
    <p class="home-thesis">A cat is not a pet you acquire. It is a life you agree to understand as it changes.</p>
  </div>

  <div class="home-workspace">
    <div class="home-scene-column">
      <div class="lifecycle-control" role="group" aria-label="Momo's life stages">
        <span class="lifecycle-control__label">Momo's age</span>
        <div class="lifecycle-segments">
          {lifecycleStages.map((stage, index) => (
            <button
              type="button"
              class="lifecycle-segment"
              data-stage-trigger={stage.id}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {stage.label}
            </button>
          ))}
        </div>
      </div>

      <div class="room-frame">
        <svg
          class="home-room"
          viewBox="0 0 1200 720"
          role="img"
          aria-labelledby="room-title room-description"
          preserveAspectRatio="xMidYMid meet"
