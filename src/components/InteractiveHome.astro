            <path d="M775 423h142l34 88H741z" fill="#f2c66a" stroke="#354b48" stroke-width="9" />
            <path d="M787 423q11-55 64-55t64 55" fill="none" stroke="#354b48" stroke-width="9" />
            <rect x="798" y="445" width="83" height="66" fill="#354b48" />
            <path d="M812 449v58m18-58v58m18-58v58m18-58v58" stroke="#f4ead7" stroke-width="5" />
          </g>

