          <path d="M0 505h1200" stroke="#354b48" stroke-width="6" />
          <path d="M600 0v505" stroke="#d7c6a5" stroke-width="5" />

          <g>
            <rect x="740" y="88" width="310" height="230" rx="4" fill="#91bcc0" stroke="#354b48" stroke-width="12" />
            <path d="M895 94v218M746 203h298" stroke="#f4ead7" stroke-width="9" />
            <path d="M725 326h345" stroke="#354b48" stroke-width="18" />
          </g>

          <g>
            <rect x="1057" y="157" width="118" height="348" fill="#d66f4d" stroke="#354b48" stroke-width="10" />
            <circle cx="1083" cy="335" r="9" fill="#f0c35a" />
          </g>

          <g>
            <rect x="248" y="385" width="395" height="166" rx="18" fill="#50736c" stroke="#354b48" stroke-width="10" />
            <rect x="222" y="333" width="94" height="190" rx="24" fill="#50736c" stroke="#354b48" stroke-width="10" />
            <rect x="575" y="333" width="94" height="190" rx="24" fill="#50736c" stroke="#354b48" stroke-width="10" />
            <path d="M445 391v155" stroke="#354b48" stroke-width="6" opacity=".45" />
          </g>

          <g>
            <ellipse cx="770" cy="585" rx="132" ry="52" fill="#d66f4d" stroke="#354b48" stroke-width="9" />
            <ellipse cx="770" cy="574" rx="92" ry="28" fill="#f2c66a" />
          </g>

          <g>
            <path d="M905 600h82l-10 39h-62z" fill="#e7e0cf" stroke="#354b48" stroke-width="8" />
            <path d="M1000 600h82l-10 39h-62z" fill="#8bb9bd" stroke="#354b48" stroke-width="8" />
