---
import { withBase } from "astro-theme-university/url";
import { chapterPath, chapters, lifecycleStages } from "../data/chapters";
import HomeScene from "./HomeScene.astro";

const firstStage = lifecycleStages[0];
const timelineMoments = ["10 weeks", "5 months", "The years between", "13 years", "19 years"];
const consultationHref = (slug: string) => {
  const chapter = chapters.find((item) => item.slug === slug);
  return chapter ? withBase(chapterPath(chapter)) : "";
};
---

<section
  id="interactive-home"
  class="interactive-home"
  data-interactive-home
  data-stage={firstStage.id}
  data-stages={JSON.stringify(lifecycleStages)}
  aria-labelledby="home-heading"
>
  <header class="home-section-intro">
    <div>
      <p class="eyebrow">Interactive home</p>
      <h2 id="home-heading">The same home, across one life</h2>
    </div>
    <p>
      Move through Milo's lifetime. Her needs, the room, and the consultations waiting inside it
      change with her.
    </p>
  </header>

  <nav class="life-timeline" aria-label="Milo's life timeline">
    <div class="life-timeline__heading">
      <p>Milo, over nineteen years</p>
      <span>Earlier</span>
      <span aria-hidden="true"></span>
      <span>Later</span>
    </div>
    <div class="life-timeline__scroll" tabindex="0" aria-label="Scroll through Milo's ages">
      <ol>
        {lifecycleStages.map((stage, index) => (
          <li>
            <button
              type="button"
              class="life-timeline__node"
              data-stage-trigger={stage.id}
              aria-label={`${timelineMoments[index]}, ${stage.label}`}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span class="life-timeline__dot" aria-hidden="true"></span>
              <span class="life-timeline__moment">{timelineMoments[index]}</span>
              <span class="life-timeline__stage">{stage.label}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <div class="home-workspace">
    <div class="home-scene-column">
      <div class="room-frame">
        <HomeScene />

        <div class="home-hotspots" role="group" aria-label="Consultation entrances">
          {chapters.map((chapter) => (
            <button
              type="button"
              class="home-hotspot"
              data-home-hotspot
              data-stage={chapter.stage}
              data-chapter={chapter.number}
              data-week={chapter.week}
              data-title={chapter.title}
              data-question={chapter.question}
              data-age={chapter.momoAge}
              data-cue={chapter.homeCue}
              data-href={chapter.implemented ? consultationHref(chapter.slug) : ""}
              aria-label={`Chapter ${chapter.number}: ${chapter.title}`}
              style={`--hotspot-x:${chapter.hotspot.x}%;--hotspot-y:${chapter.hotspot.y}%`}
            >
              <span>{chapter.number}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <aside class="home-context" aria-live="polite" aria-labelledby="selected-chapter-title">
      <p class="home-context__meta" data-stage-meta>{firstStage.age}</p>
      <p class="home-context__stage-note" data-stage-note>{firstStage.note}</p>
      <div class="home-context__rule"></div>
      <p class="home-context__chapter" data-selected-number>Chapter 1 · Week 1</p>
      <h3 id="selected-chapter-title" data-selected-title>{chapters[0].title}</h3>
      <p data-selected-cue>{chapters[0].homeCue}</p>
      <p class="home-context__question" data-selected-question>{chapters[0].question}</p>
      <a class="primary-action" data-selected-link href={consultationHref(chapters[0].slug)}>
        Begin consultation
      </a>
      <p class="availability-note" data-selected-availability hidden>
        This consultation will be built after the Chapter 1 system is validated.
      </p>
    </aside>
  </div>

  <details class="home-fallback">
    <summary>Browse all twelve chapters as a list</summary>
    <ol>
      {chapters.map((chapter) => (
        <li>
          {chapter.implemented ? (
            <a href={consultationHref(chapter.slug)}>Chapter {chapter.number}: {chapter.title}</a>
          ) : (
            <span>Chapter {chapter.number}: {chapter.title}</span>
          )}
          <span>{chapter.momoAge}</span>
        </li>
      ))}
    </ol>
    <a href={withBase("/chapters/")}>Open the accessible course journey</a>
  </details>
</section>

<script>
  function setupInteractiveHome() {
    for (const home of document.querySelectorAll<HTMLElement>("[data-interactive-home]")) {
      if (home.dataset.initialized === "true") continue;
      home.dataset.initialized = "true";

      const triggers = [...home.querySelectorAll<HTMLButtonElement>("[data-stage-trigger]")];
      const hotspots = [...home.querySelectorAll<HTMLButtonElement>("[data-home-hotspot]")];
      const stageLayers = [...home.querySelectorAll<SVGGElement>("[data-room-stage]")];
      const selectedNumber = home.querySelector<HTMLElement>("[data-selected-number]")!;
      const selectedTitle = home.querySelector<HTMLElement>("[data-selected-title]")!;
      const selectedCue = home.querySelector<HTMLElement>("[data-selected-cue]")!;
      const selectedQuestion = home.querySelector<HTMLElement>("[data-selected-question]")!;
      const selectedLink = home.querySelector<HTMLAnchorElement>("[data-selected-link]")!;
      const availability = home.querySelector<HTMLElement>("[data-selected-availability]")!;
      const stageMeta = home.querySelector<HTMLElement>("[data-stage-meta]")!;
      const stageNote = home.querySelector<HTMLElement>("[data-stage-note]")!;
      const stages = JSON.parse(home.dataset.stages ?? "[]") as Array<{
        id: string;
        age: string;
        note: string;
      }>;

      function selectChapter(hotspot: HTMLButtonElement) {
        hotspots.forEach((item) => item.classList.toggle("is-selected", item === hotspot));
        selectedNumber.textContent = `Chapter ${hotspot.dataset.chapter} · Week ${hotspot.dataset.week}`;
        selectedTitle.textContent = hotspot.dataset.title ?? "";
        selectedCue.textContent = hotspot.dataset.cue ?? "";
        selectedQuestion.textContent = hotspot.dataset.question ?? "";
        const href = hotspot.dataset.href;
        selectedLink.hidden = !href;
        if (href) selectedLink.href = href;
        availability.hidden = Boolean(href);
      }

      function selectStage(stageId: string) {
        home.dataset.stage = stageId;
        triggers.forEach((trigger) => {
          trigger.setAttribute("aria-pressed", String(trigger.dataset.stageTrigger === stageId));
        });
        stageLayers.forEach((layer) => {
          layer.style.display = layer.dataset.roomStage === stageId ? "" : "none";
        });
        hotspots.forEach((hotspot) => {
          hotspot.hidden = hotspot.dataset.stage !== stageId;
        });

        const stage = stages.find((item) => item.id === stageId);
        stageMeta.textContent = stage?.age ?? "";
        stageNote.textContent = stage?.note ?? "";
        const first = hotspots.find((item) => !item.hidden);
        if (first) {
          selectChapter(first);
        } else {
          hotspots.forEach((item) => item.classList.remove("is-selected"));
          selectedNumber.textContent = "Between Chapters 9 and 10";
          selectedTitle.textContent = "The ordinary years matter too";
          selectedCue.textContent =
            "The routines built earlier become the baseline that later change is measured against.";
          selectedQuestion.textContent =
            "Milo's life is not paused simply because the course turns a page.";
          selectedLink.hidden = true;
          availability.hidden = true;
        }
      }

      triggers.forEach((trigger, index) => {
        trigger.addEventListener("click", () => selectStage(trigger.dataset.stageTrigger ?? "kitten"));
        trigger.addEventListener("keydown", (event) => {
          let nextIndex: number | undefined;
          if (event.key === "ArrowRight") nextIndex = Math.min(index + 1, triggers.length - 1);
          if (event.key === "ArrowLeft") nextIndex = Math.max(index - 1, 0);
          if (event.key === "Home") nextIndex = 0;
          if (event.key === "End") nextIndex = triggers.length - 1;
          if (nextIndex === undefined || nextIndex === index) return;
          event.preventDefault();
          triggers[nextIndex].focus();
          selectStage(triggers[nextIndex].dataset.stageTrigger ?? "kitten");
        });
      });
      hotspots.forEach((hotspot) => {
        hotspot.addEventListener("click", () => selectChapter(hotspot));
      });

      // Every visit begins at the start of Milo's life, independent of previous choices.
      selectStage("kitten");
    }
  }

  setupInteractiveHome();
  document.addEventListener("astro:page-load", setupInteractiveHome);
</script>
