---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import { withBase } from "astro-theme-university/url";
import MarkingModel from "../../components/MarkingModel.astro";
import { courseMeta } from "../../course-config";
import CourseLayout from "../../layouts/CourseLayout.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections } from "../../site-config";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { Content } = await render(assessment);
---

<CourseLayout
  title={assessment.data.title}
  description={assessment.data.description ?? undefined}
  pageClass="course-shell-page"
>
  <article class="assignment-brief">
    <header class="assignment-brief__hero">
      <a href={withBase("/assessments/")}>Assignments</a>
      <p class="eyebrow">{courseMeta.code} · Formal assessment</p>
      <h1>{assessment.data.title}</h1>
      <p>{assessment.data.description}</p>
      <dl>
        <div><dt>Weight</dt><dd>{assessment.data.weight}%</dd></div>
        <div><dt>Due</dt><dd>{formatCourseDate(assessment.data.due)}</dd></div>
        <div><dt>Course stage</dt><dd>{assessment.data.stage}</dd></div>
      </dl>
    </header>
    <div class="assignment-brief__body">
      {assessment.data.draft && (
        <Callout type="warning"><p><strong>Draft.</strong> This brief is still being finalised and may change.</p></Callout>
      )}
      <section class="assignment-brief__deliverable" aria-labelledby="deliverable-title">
        <p class="eyebrow">The hand-in</p>
        <h2 id="deliverable-title">What leaves your desk</h2>
        <p>{assessment.data.deliverable}</p>
      </section>
      <Content />
      <SpecList spec={assessment.data.spec}>
        These expectations are the fixed part of the brief. They make the work
        inspectable without reducing the quality of judgement to a checklist.
      </SpecList>
      {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}
      <RelatedContent entry={assessment} collections={graphCollections} />
    </div>
  </article>
</CourseLayout>
