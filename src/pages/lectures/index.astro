---
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../../course-config";
import { chapterPath, chapters, teachingWeekLabel } from "../../data/chapters";
import CourseLayout from "../../layouts/CourseLayout.astro";

const firstCapture = chapters[0];
---

<CourseLayout
  title="Capture"
  description="A warm field notebook of observation, explanation, evidence, decisions, and reflection across Milo's life."
  pageClass="capture-index-page"
>
  <section class="capture-index" aria-labelledby="capture-index-title">
    <header class="capture-index__header">
      <div>
        <p class="eyebrow">{courseMeta.code} · Course learning</p>
        <h1 id="capture-index-title">Capture</h1>
      </div>
      <p>
        A warm field notebook following one cat across a lifetime. Each Capture begins with a
        moment to notice and ends with a decision worth revisiting.
      </p>
    </header>

    <div class="capture-index__prototype">
      <div>
        <p class="capture-index__number">
          Capture 01 · {teachingWeekLabel(firstCapture)} · {firstCapture.momoAge}
        </p>
        <h2>Begin where Milo's record begins</h2>
        <p>
          The carrier door opens and Milo disappears under the bed. Begin with what the room can
          actually tell you, then return with a safer first-72-hours plan.
        </p>
      </div>
      <div class="capture-index__actions">
        <a class="primary-action" href={withBase(chapterPath(firstCapture))}>
          Begin Capture 01
        </a>
        <a href={withBase("/decks/capture-01-briefing/")}>Open briefing deck</a>
      </div>
    </div>

    <p class="capture-index__template-link">
      <a href={withBase("/lectures/capture-field-guide/")}>Read the Capture field guide</a>
      <span> · An auxiliary guide for all twelve Captures</span>
    </p>

    <section class="capture-index__sequence" aria-labelledby="capture-sequence-title">
      <div>
        <p class="eyebrow">The field notebook</p>
        <h2 id="capture-sequence-title">Twelve captures, one changing life</h2>
      </div>
      <ol aria-label="Twelve Capture chapters">
        {chapters.map((chapter) => (
          <li>
            <span class="capture-index__sequence-number">
              Capture {String(chapter.number).padStart(2, "0")}
            </span>
            {chapter.implemented ? (
              <a href={withBase(chapterPath(chapter))}>{chapter.title}</a>
            ) : (
              <span class="capture-index__sequence-title">{chapter.title}</span>
            )}
            <time datetime={chapter.date}>{teachingWeekLabel(chapter)}</time>
          </li>
        ))}
      </ol>
    </section>
  </section>
</CourseLayout>
