---
import { getCollection } from "astro:content";
import ArrivalPractice from "../../components/ArrivalPractice.astro";
import CarePlan from "../../components/CarePlan.astro";
import ChapterCheck from "../../components/ChapterCheck.astro";
import ConsultationLayout from "../../components/ConsultationLayout.astro";
import JudgementQuestion from "../../components/JudgementQuestion.astro";
import ScenarioScene from "../../components/ScenarioScene.astro";
import { getChapter } from "../../data/chapters";
import CourseLayout from "../../layouts/CourseLayout.astro";

const chapter = getChapter("the-first-72-hours");
if (!chapter) throw new Error("Chapter 1 course data is missing");

const chapterChecks = await getCollection("chapterChecks");
const check = chapterChecks.find((entry) => entry.data.chapter === chapter.number)?.data;
if (!check) throw new Error("Chapter 1 check data is missing");

const steps = [
  { id: "scenario", label: "Scenario" },
  { id: "observation", label: "Observation" },
  { id: "initial-judgement", label: "Initial judgement" },
  { id: "core-learning", label: "Core learning" },
  { id: "guided-reading", label: "Guided reading" },
  { id: "practice", label: "Practice" },
  { id: "return", label: "Return to Milo" },
  { id: "care-plan", label: "Care plan" },
  { id: "chapter-check", label: "Chapter Check" },
];

const arrivalOptions = [
  {
    id: "a",
    text: "Reach under the bed and gently pull her out so she can start getting used to the house.",
  },
  {
    id: "b",
    text: "Leave accessible resources and a hiding place nearby, then let her come out when she is ready.",
  },
  {
    id: "c",
    text: "Leave her completely alone without food or litter nearby, and check again in a day or two.",
  },
];

const carePlan = [
  {
    action: "Remove foreseeable hazards before arrival",
    reason: "Remove true lilies entirely, secure human medication, and use only pest products labelled safe for cats.",
    claimIds: ["CH1-07"],
  },
  {
    action: "Prepare one small, quiet first territory",
    reason: "Include a defensible hiding place and rest area, with litter physically separated from food and water.",
    claimIds: ["CH1-02", "CH1-03"],
  },
  {
    action: "Keep the carrier open and familiar",
    reason: "Let it remain part of ordinary safe territory instead of appearing only before disruptive travel.",
    claimIds: ["CH1-04"],
  },
  {
    action: "Reduce demands and follow Milo's pace",
    reason: "Do not chase, retrieve, pick up, or force contact; expand the territory gradually as she settles.",
    claimIds: ["CH1-01", "CH1-05", "CH1-06"],
  },
  {
    action: "Arrange prompt veterinary screening",
    reason: "Keep Milo separate from resident cats until veterinary examination, FeLV/FIV screening, and parasite checks are addressed.",
    claimIds: ["CH1-08"],
  },
  {
    action: "Start Milo's daily observation log",
    reason: "Record eating, drinking, litter use, energy, hiding, and exploration so later change has a personal baseline.",
    claimIds: ["CH1-09"],
  },
];
---

<CourseLayout
  title={`Chapter ${chapter.number}: ${chapter.title}`}
  description={chapter.question}
  pageClass="consultation-page"
>
  <ConsultationLayout
    chapter={chapter.number}
    title={chapter.title}
    age={chapter.momoAge}
    steps={steps}
  >
    <section id="scenario" class="consultation-section consultation-section--opening" aria-labelledby="scenario-heading">
      <div class="section-heading">
        <p class="section-kicker">Scenario</p>
        <h2 id="scenario-heading">The carrier door opens. Milo disappears.</h2>
        <p>
          The spare room is ready before Milo arrives: the carrier sits open, and the bowls and
          litter tray are not crowded together. Milo is about ten weeks old.
          Six minutes after the carrier door opens, she is under the bed. You can hear one small
          movement against the skirting board, then nothing.
        </p>
      </div>
      <ScenarioScene />
      <aside class="withheld-note">
        <strong>What you do not know yet</strong>
        <p>
          You do not know how long Milo will stay there or whether approaching her would help.
          The silence does not tell you what she feels. Make the first decision from what you can
          observe, not from the story the empty room invites you to invent.
        </p>
      </aside>
    </section>

    <section id="observation" class="consultation-section" aria-labelledby="observation-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-kicker">Observe before explaining</p>
          <h2 id="observation-heading">What do you actually notice?</h2>
        </div>
        <p>Keep observation separate from the story you are tempted to tell about it.</p>
      </div>
      <form class="observation-note" data-observation-note>
        <label for="arrival-observation">Write only what a camera or simple record could confirm.</label>
        <textarea id="arrival-observation" rows="5" placeholder="For example: The carrier door is open..."></textarea>
        <div>
          <button type="submit">Save observation</button>
          <p data-observation-status aria-live="polite"></p>
        </div>
      </form>
      <details class="observation-reveal">
        <summary>Compare with the visible evidence</summary>
        <ul>
          <li>The carrier door is open and the carrier is empty.</li>
          <li>Milo moved under the bed within minutes of arrival.</li>
          <li>She can be heard but is not currently visible.</li>
          <li>No evidence yet shows why she hid or what she will do next.</li>
        </ul>
      </details>
    </section>

    <section id="initial-judgement" class="consultation-section consultation-section--tint" aria-labelledby="initial-heading">
      <div class="section-heading">
        <p class="section-kicker">First judgement</p>
        <h2 id="initial-heading">What should you do right now?</h2>
        <p>Your answer is saved locally so you can compare it with your later judgement.</p>
      </div>
      <JudgementQuestion
        id="arrival-initial"
        phase="initial"
        prompt="Milo will not come out from under the bed. What should you do?"
        options={arrivalOptions}
        bestOption="b"
      />
    </section>

    <section id="core-learning" class="consultation-section" aria-labelledby="learning-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-kicker">Core learning</p>
          <h2 id="learning-heading">Build safety before you ask for confidence</h2>
        </div>
        <p>
          By the end of this consultation, you should be able to prepare one room, respond to a
          hiding kitten without forcing contact, arrange prompt veterinary screening, and begin a
          useful observation record.
        </p>
      </div>

      <div class="learning-threads">
        <section class="learning-thread" aria-labelledby="learning-before-arrival">
          <div class="learning-thread__marker"><span>01</span><p>Before arrival</p></div>
          <div class="reading-prose">
            <h3 id="learning-before-arrival">Some risks cannot be managed by watching</h3>
            <p>
              A kitten makes ordinary rooms look different. The tablet beside a glass of water is
              no longer merely untidy. A flower on a high shelf is not safely outside the room if
              pollen or a petal can fall. The flea treatment left from a dog is not interchangeable
              with a product labelled for cats. Preparation starts with the things already in the
              household, before it starts with shopping.
            </p>
            <p>
              True lilies in the <em>Lilium</em> and <em>Hemerocallis</em> groups need the clearest
              decision: remove them from the home entirely. Leaves, stems, petals, and even pollen
              can cause life-threatening kidney injury from a small exposure. “Out of reach” is not
              a reliable boundary for a mobile cat or for loose plant material.
            </p>
            <p>
              Secure human medication such as ibuprofen and naproxen where a curious kitten cannot
              knock it loose. Read the species label on flea, tick, and insecticide products before
              use; a dog or household product is not automatically safe for a cat. These actions do
              not depend on noticing a symptom later. They remove foreseeable exposure first.
            </p>
            <aside class="principle-note"><strong>The owner-level decision</strong><p>Remove or secure the known hazard before exposure. Watching a known hazard is not the same as removing it.</p></aside>
            <p class="claim-list">CH1-07 · Direct evidence</p>
          </div>
        </section>

        <section class="learning-thread" aria-labelledby="learning-hiding">
          <div class="learning-thread__marker"><span>02</span><p>Read the behaviour</p></div>
          <div class="reading-prose">
            <h3 id="learning-hiding">Under the bed is a coping strategy</h3>
            <p>
              Milo has moved from a carrier into a room without a familiar route, scent map, or
              routine. Hiding reduces what reaches her and gives her some control over distance. In
              a newly arrived cat, that withdrawal is a normal coping and stress-reduction
              behaviour. It is not disobedience, a failed adoption, or a social problem that must be
              corrected in the first hour.
            </p>
            <p>
              The owner's urge to reach under the bed is understandable. There is a small animal in
              an unfamiliar room, and doing nothing can feel careless. But pulling Milo out would
              answer the owner's uncertainty by taking away the strategy Milo is already using.
              Forced reassurance is still forced contact.
            </p>
            <p>
              A useful safe place is private and defensible, often enclosed or raised. It does not
              have to make a cat literally unreachable. A stable covered box or an open carrier can
              work because Milo can withdraw, watch, and leave without being handled. Provide at
              least one safe place for each cat in the household.
            </p>
            <blockquote>Care can look quiet: a closed door, an available tray, a bowl checked without fanfare, and a person who leaves before patience turns into pressure.</blockquote>
            <p class="claim-list">CH1-01 · CH1-02 · Direct evidence</p>
          </div>
        </section>

        <section class="learning-thread" aria-labelledby="learning-room">
          <div class="learning-thread__marker"><span>03</span><p>Design the room</p></div>
          <div class="reading-prose">
            <h3 id="learning-room">A safe room is a map, not a pile of supplies</h3>
            <p>
              Food, water, litter, rest, and hiding all need to be accessible inside Milo's first
              territory. Accessibility does not mean lining them up for the owner's convenience.
              Separate the resources physically, with particular care to keep the litter tray away
              from food and water. The room can be small while each function still has its own place.
            </p>
            <dl class="resource-map">
              <div><dt>Food and water</dt><dd>Reachable without crossing the busy doorway, and separated from the litter area.</dd></div>
              <div><dt>Litter</dt><dd>In a quiet, accessible position away from eating and drinking.</dd></div>
              <div><dt>Rest</dt><dd>A low-pressure place where household movement does not repeatedly interrupt settling.</dd></div>
              <div><dt>Hide</dt><dd>Private and defensible, with Milo able to enter and leave without being retrieved.</dd></div>
              <div><dt>Carrier</dt><dd>Open and available as an ordinary familiar object, rather than stored until the next vet trip.</dd></div>
            </dl>
            <p>
              The course also recommends expanding access to the rest of the home gradually. This
              is informed guidance drawn from the environmental principles of familiarity,
              predictability, and gradual introduction; it is a <strong>synthesis</strong>, not a
              room-by-room rule quoted directly from a guideline. Watch how Milo uses the first
              territory and open the next area deliberately instead of treating the whole house as
              one immediate test.
            </p>
            <p class="claim-list">CH1-03 · CH1-04 · Direct evidence · CH1-06 · Synthesis</p>
          </div>
        </section>

        <section class="learning-thread" aria-labelledby="learning-contact">
          <div class="learning-thread__marker"><span>04</span><p>Protect choice</p></div>
          <div class="reading-prose">
            <h3 id="learning-contact">Low pressure still contains care</h3>
            <p>
              Let Milo initiate an approach and end contact. Do not chase, retrieve, pick up, or
              force petting because the first meeting feels overdue. The same rule applies to other
              people. A calm visitor can still be one demand too many on the first evening.
            </p>
            <p>
              “Leave her alone” becomes poor guidance when it means removing attention to food,
              water, litter, or change. Low pressure is active: enter quietly when needed, maintain
              the resources, notice what has changed, and leave without turning every visit into an
              attempt at contact. Milo controls social distance; the owner remains responsible for
              the room.
            </p>
            <p class="claim-list">CH1-05 · Direct evidence</p>

            <div class="transfer-question">
              <p class="section-kicker">Transfer case · first evening</p>
              <p>Three friends ask to visit. They promise to sit quietly and “just have a look.” The offer is gentle; the timing is still yours to judge.</p>
              <JudgementQuestion
                id="visitors-transfer"
                phase="transfer"
                prompt="What plan best protects Milo's first evening without turning caution into permanent isolation?"
                options={[
                  { id: "a", text: "Invite them for a short quiet visit so Milo begins getting used to people.", feedback: "The quiet conditions sound considerate, but the visit still adds an avoidable social demand before Milo has established security in the room." },
                  { id: "b", text: "Ask them to wait; make a later visit calm and let Milo choose whether to appear or approach.", feedback: "This protects the first evening while keeping future contact possible, gradual, and directed by Milo's willingness to appear or approach." },
                  { id: "c", text: "Cancel all future visits until Milo is completely comfortable with every part of the home.", feedback: "This begins with caution but turns temporary low-pressure care into indefinite avoidance. Later, gradual and cat-directed contact can still be appropriate." },
                ]}
                bestOption="b"
              />
            </div>
          </div>
        </section>

        <section class="learning-thread" aria-labelledby="learning-vet">
          <div class="learning-thread__marker"><span>05</span><p>After arrival</p></div>
          <div class="reading-prose">
            <h3 id="learning-vet">Looking well is not medical clearance</h3>
            <p>
              Milo may eat, explore, and look healthy before an owner knows her health history.
              Those observations are useful, but they cannot clear risks that are not visible. A
              newly adopted cat or kitten with an unknown history should be examined by a
              veterinarian as soon as possible after arrival, including screening for FeLV and FIV
              and checks for internal and external parasites.
            </p>
            <p>
              If another cat already lives in the home, keep Milo separate until that screening is
              done. The safe room now has two jobs: it reduces pressure on Milo and maintains a
              practical boundary while veterinary screening is arranged. The owner is not being
              asked to identify an infection. The decision is to book the examination and preserve
              separation until professional screening addresses it.
            </p>
            <aside class="principle-note"><strong>Make the appointment concrete</strong><p>“Soon” is easy to postpone. Put the veterinary examination and screening on the first-arrival task list.</p></aside>
            <p class="claim-list">CH1-08 · Direct evidence</p>
          </div>
        </section>

        <section class="learning-thread" aria-labelledby="learning-log">
          <div class="learning-thread__marker"><span>06</span><p>Start the baseline</p></div>
          <div class="reading-prose">
            <h3 id="learning-log">Day one belongs in the record</h3>
            <p>
              Write down roughly how much Milo ate and drank, whether and how the litter tray was
              used, her energy level, and whether she hid or explored. Keep the entry plain. “Used
              the tray once” is an observation. “Was upset with me” is an interpretation the room
              cannot confirm.
            </p>
            <p>
              This daily habit is a course recommendation: a practical bridge from arrival to the
              later question, “Is this different for Milo?” It is not a diagnostic method and it
              does not replace a veterinarian. Its value is personal and cumulative. A dated line
              written tonight gives tomorrow something real to be compared with.
            </p>
            <p>
              The same notebook will return across Milo's life. Later it can hold body-condition
              observations, dental and facial signs, and changes that matter in old age. For now,
              the first page needs only what you could see, hear, count, or reasonably estimate.
            </p>
            <p class="claim-list">CH1-09 · Course synthesis</p>
          </div>
        </section>
      </div>

      <aside class="evidence-trail">
        <div><p class="section-kicker">Evidence trail</p><h3>Where these claims come from</h3></div>
        <ul>
          <li><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC11383066/">AAFP / ISFM feline environmental needs guidance</a></li>
          <li><a href="https://www.vet.cornell.edu/departments-centers-and-institutes/cornell-feline-health-center/health-information/feline-health-topics/choosing-and-caring-your-new-cat">Cornell Feline Health Center: choosing and caring for a new cat</a></li>
          <li><a href="https://www.aspca.org/news/these-harmful-feline-hazards-could-be-your-home">ASPCA Animal Poison Control: household hazards</a></li>
        </ul>
      </aside>
    </section>

    <section id="guided-reading" class="consultation-section consultation-section--reading" aria-labelledby="guided-reading-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-kicker">Guided reading · about 40 minutes</p>
          <h2 id="guided-reading-heading">Read the guidance with a room in mind</h2>
        </div>
        <p>Use the source material to test the decisions above. You are reading for owner action, not for a list of terms.</p>
      </div>
      <ol class="reading-list">
        <li>
          <div><span>15 min</span><h3>Environmental needs</h3></div>
          <p>Read the safe-place, separated-resource, and human-interaction sections in the AAFP/ISFM guidance. Sketch Milo's room from above and mark where each principle becomes a physical decision.</p>
          <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC11383066/">Open the AAFP/ISFM guidance</a>
        </li>
        <li>
          <div><span>10 min</span><h3>Household hazards</h3></div>
          <p>Read the ASPCA material for the three registered Chapter 1 hazards. For each one, write the action that must happen before arrival rather than the symptom you might watch for afterwards.</p>
          <a href="https://www.aspca.org/news/these-harmful-feline-hazards-could-be-your-home">Open the ASPCA hazard guidance</a>
        </li>
        <li>
          <div><span>15 min</span><h3>The first veterinary visit</h3></div>
          <p>Read Cornell's new-cat guidance and locate the reason a healthy appearance is not the same as screening. Write the owner action and the boundary that protects a resident cat while the visit is arranged.</p>
          <a href="https://www.vet.cornell.edu/departments-centers-and-institutes/cornell-feline-health-center/health-information/feline-health-topics/choosing-and-caring-your-new-cat">Open the Cornell Feline Health Center guidance</a>
        </li>
      </ol>
    </section>

    <section id="practice" class="consultation-section consultation-section--tint" aria-labelledby="practice-heading">
      <div class="section-heading">
        <p class="section-kicker">Practice and compare</p>
        <h2 id="practice-heading">Now prepare a room you have not seen before</h2>
        <p>The exercise keeps the three tasks together: remove hazards, place resources, then write the first observation entry.</p>
      </div>
      <div class="comparison-grid">
        <article>
          <p class="comparison-label">Room A</p>
          <h3>Everything together, everyone welcome</h3>
          <ul>
            <li>Food, water, and litter lined up beside the door</li>
            <li>Carrier stored away after arrival</li>
            <li>Visitors invited to “help her socialise”</li>
            <li>Whole-house access from the first hour</li>
          </ul>
          <p>This looks generous and efficient, but concentrates pressure and removes retreat.</p>
        </article>
        <article class="comparison-grid__preferred">
          <p class="comparison-label">Room B · Safer fit</p>
          <h3>Essentials separated, choices preserved</h3>
          <ul>
            <li>Litter separated from food and water</li>
            <li>Carrier open beside another hiding option</li>
            <li>Quiet maintenance with no forced contact</li>
            <li>Territory widened only as Milo settles</li>
          </ul>
          <p>The difference is not the shopping list. It is how the room protects control.</p>
        </article>
      </div>

      <ArrivalPractice />
    </section>

    <section id="return" class="consultation-section" aria-labelledby="return-heading">
      <div class="section-heading">
        <p class="section-kicker">Return to Milo</p>
        <h2 id="return-heading">The room is quiet. Milo is still under the bed.</h2>
        <p>
          By evening, the food bowl shows a small disturbance. The litter tray has been used once.
          Milo is still mostly hidden, but now she watches from the edge of cover. Nothing dramatic
          has happened. Care has: hazards were removed, resources stayed accessible, the veterinary
          visit is being arranged, and Milo still controls the distance.
        </p>
      </div>
      <ScenarioScene phase="return" />
      <div class="revised-judgement">
        <h3>Make the decision again</h3>
        <JudgementQuestion
          id="arrival-revised"
          phase="revised"
          prompt="With the evidence now in view, what should you do next?"
          options={arrivalOptions}
          bestOption="b"
        />
      </div>
    </section>

    <section id="care-plan" class="consultation-section consultation-section--dark" aria-labelledby="care-plan-heading">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-kicker">Recommendation</p>
          <h2 id="care-plan-heading">Milo's first-72-hours care plan</h2>
        </div>
        <p>Six owner-level actions, each attached to the reason it exists.</p>
      </div>
      <CarePlan items={carePlan} />
    </section>

    <section id="chapter-check" class="consultation-section consultation-section--check" aria-labelledby="chapter-check-heading">
      <ChapterCheck check={check} />
    </section>

    <section class="workload-map" aria-labelledby="workload-heading">
      <div>
        <p class="section-kicker">Chapter workload</p>
        <h2 id="workload-heading">This consultation maps to about 4 hours 10 minutes</h2>
      </div>
      <dl>
        <div><dt>Core teaching</dt><dd>~50 min</dd></div>
        <div><dt>Guided reading</dt><dd>~40 min</dd></div>
        <div><dt>Scenario analysis</dt><dd>~45 min</dd></div>
        <div><dt>Applied activity</dt><dd>~90 min</dd></div>
        <div><dt>Check and review</dt><dd>~25 min</dd></div>
      </dl>
      <p>
        The consultation combines reading, evidence tracing, three judgement points, a complete
        room-preparation activity, a saved observation entry, and formative review. The time is a
        learning estimate, not a timer; careful comparison and revision are part of the work.
      </p>
    </section>
  </ConsultationLayout>
</CourseLayout>

<script>
  function setupObservationNotes() {
    for (const form of document.querySelectorAll<HTMLFormElement>("[data-observation-note]")) {
      if (form.dataset.initialized === "true") continue;
      form.dataset.initialized = "true";
      const input = form.querySelector<HTMLTextAreaElement>("textarea")!;
      const status = form.querySelector<HTMLElement>("[data-observation-status]")!;
      const key = "momo-ch01-arrival-observation";
      input.value = localStorage.getItem(key) ?? "";
      if (input.value) status.textContent = "Your observation is restored on this device.";
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        localStorage.setItem(key, input.value);
        status.textContent = input.value.trim()
          ? "Observation saved locally."
          : "Write one concrete observation before saving.";
      });
    }
  }

  setupObservationNotes();
  document.addEventListener("astro:page-load", setupObservationNotes);
</script>
