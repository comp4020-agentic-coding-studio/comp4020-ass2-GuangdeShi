---
import { getChapter } from "../../data/chapters";
import CourseLayout from "../../layouts/CourseLayout.astro";

const chapter = getChapter("the-first-72-hours");
if (!chapter) throw new Error("Chapter 1 course data is missing");
---

<CourseLayout
  title={`Chapter ${chapter.number}: ${chapter.title}`}
  description={chapter.question}
  pageClass="consultation-page"
>
  <article class="consultation-shell">
    <p class="eyebrow">Chapter {chapter.number} · Care consultation</p>
    <h1>{chapter.title}</h1>
    <p>{chapter.question}</p>
    <p><strong>Structural prototype:</strong> consultation content is being mapped from the reviewed Chapter 1 plan.</p>
  </article>
</CourseLayout>
